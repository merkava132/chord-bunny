{
  "name": "chord-bunny",
  "version": "1.2.0",
  "description": "Guitar chord transition trainer that listens (vanilla JS, no dependencies)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "serve": "python3 serve.py",
    "test": "node --test tests/*.test.mjs",
    "bench": "node tools/bench.mjs",
    "eval:chords": "node tools/eval_chords.mjs",
    "eval:hold": "node tools/eval_hold.mjs --minseg=2",
    "eval:listen": "node tools/eval_listen.mjs",
    "eval:strings": "node tools/eval_strings.mjs",
    "calibrate": "node tools/calibrate.mjs",
    "report": "node tools/telemetry_report.mjs latest",
    "stats": "node tools/stats.mjs",
    "bench:personal": "node tools/personal_bench.mjs --diag --write=docs/PERSONAL.md",
    "model:extract": "node tools/train_model.mjs extract --augment=2 --noise=/mnt/aegis/chord-bunny/noise",
    "model:train": "node tools/train_model.mjs train --hidden=64 --dropout=0.2 --noise=0.1 --user-weight=5 --write=data/model.json",
    "model:cv": "node tools/model_cv.mjs --json=docs/model_cv.json",
    "labels": "node tools/session_labels.mjs latest --replay",
    "fetch-testdata": "python3 testdata/fetch_guitarset.py"
  },
  "engines": { "node": ">=20" }
}
